{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "@offprompt/site#test": {},
    "test:browser": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}

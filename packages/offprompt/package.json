{
  "name": "offprompt",
  "version": "0.1.0",
  "private": true,
  "description": "Hand a secret to a coding agent without the secret entering the transcript.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./showcase": {
      "types": "./src/showcase.ts",
      "default": "./dist/showcase.mjs"
    },
    "./notices": "./scripts/notices.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='src/**'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
